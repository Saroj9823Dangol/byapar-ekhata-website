a:["$","div",null,{"className":"max-w-3xl","children":[["$","section","who-we-are",{"id":"who-we-are","className":"scroll-mt-24 pb-12","children":[["$","h2",null,{"className":"display-sm flex gap-4 text-[22px] sm:text-[26px]","children":[["$","span",null,{"className":"tnum text-brand","children":"01"}],"Who we are"]}],["$","div",null,{"className":"legal-body text-ink-soft mt-5 space-y-4 text-[14.5px] leading-relaxed","children":[["$","p",null,{"children":["Byapar ePartner"," is operated by ","Byapar eKhata"," Pvt. Ltd. (“we”, “us”)."," ","Byapar ePartner"," is the app for partners — the people who introduce businesses to Byapar eKhata and earn commission when those businesses subscribe. We are the data controller for the personal information described in this policy."]}],["$","p",null,{"children":["This policy covers the ","Byapar ePartner"," mobile applications for Android and iOS, and any partner pages we provide on this website. It does not cover the Byapar eKhata app used by the businesses you refer; that product has its own ",["$","$L17",null,{"href":"/privacy","children":"privacy policy"}],". If you also use Byapar eKhata to keep books for a business of your own, that policy applies to your business records and this one applies to your partner account."]}],["$","p",null,{"children":["Questions about this policy, or a request about your information, can be sent to"," ",["$","a",null,{"href":"mailto:hello@byaparekhata.com","children":"hello@byaparekhata.com"}]," or to ","Putalisadak, Kathmandu 44600, Nepal","."]}]]}]]}],["$","section","what-we-collect",{"id":"what-we-collect","className":"scroll-mt-24 pb-12","children":[["$","h2",null,{"className":"display-sm flex gap-4 text-[22px] sm:text-[26px]","children":[["$","span",null,{"className":"tnum text-brand","children":"02"}],"Information we collect"]}],["$","div",null,{"className":"legal-body text-ink-soft mt-5 space-y-4 text-[14.5px] leading-relaxed","children":[["$","h3",null,{"children":"Account and sign-in details"}],["$","p",null,{"children":"Your full name; your mobile number, which is used to sign in with a one-time code; your email address if you provide one; your preferred language; a password if you choose to set one, which we store only as a hash; and a profile photo, city, district or address if you add them. If you sign in with Google or Apple, we receive the account identifier and the name and email address those services share with us."}],["$","h3",null,{"children":"Partner and commission records"}],["$","p",null,{"children":"Your referral code; the businesses attributed to you and when they joined; the plan each one is on and whether that subscription is active; the commission each one generates; your rank in the programme; your wallet balance; and every movement in that wallet. These records are what your dashboard, statements and payouts are calculated from."}],["$","h3",null,{"children":"Payout details"}],["$","p",null,{"children":"When you request a payout we record the amount, the status of the request and any note you add. To pay you, we also hold the account details you give us for that purpose — for example the account name and number for a bank transfer. We do not collect your bank passwords, wallet PINs or full card numbers."}],["$","h3",null,{"children":"Device, technical and usage information"}],["$","p",null,{"children":"Device model and manufacturer, operating system and version, app version and build, language and time zone, IP address, a device identifier we use to bind your sessions, and your push notification token. We also receive crash reports and diagnostic logs, and aggregate information about which screens and features are used."}],"$L18","$L19"]}]]}],"$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27"]}]
