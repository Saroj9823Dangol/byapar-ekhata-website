1a:["$","section","referred-businesses",{"id":"referred-businesses","className":"scroll-mt-24 pb-12","children":[["$","h2",null,{"className":"display-sm flex gap-4 text-[22px] sm:text-[26px]","children":[["$","span",null,{"className":"tnum text-brand","children":"03"}],"Information about the businesses you refer"]}],["$","div",null,{"className":"legal-body text-ink-soft mt-5 space-y-4 text-[14.5px] leading-relaxed","children":[["$","p",null,{"children":"For each business attributed to you we hold its name, mobile number, address, the plan it is on, whether that subscription is active, and the commission it generates. We show you that much so you can confirm a referral was recorded correctly, see which of your clients are still subscribed, and understand what you are being paid for."}],["$","p",null,{"children":"You do not receive the business’s ledgers, invoices, customers, payments or any other financial records. Those belong to the business and are covered by its own agreement with us."}],["$","p",null,{"children":"Because this information belongs to someone else, use it only to contact that business about its Byapar eKhata subscription. Do not use it for your own marketing, pass it to anyone else, copy it into a mailing list, or keep it after the business stops being your referral."}],["$","p",null,{"children":"Where a referral reaches you through the customer referral programme rather than directly, the referral record also shows the name of the customer who made the introduction."}]]}]]}]
1b:["$","section","how-we-use-it",{"id":"how-we-use-it","className":"scroll-mt-24 pb-12","children":[["$","h2",null,{"className":"display-sm flex gap-4 text-[22px] sm:text-[26px]","children":[["$","span",null,{"className":"tnum text-brand","children":"04"}],"How we use your information"]}],["$","div",null,{"className":"legal-body text-ink-soft mt-5 space-y-4 text-[14.5px] leading-relaxed","children":[["$","ul",null,{"children":[["$","li",null,{"children":"To create and secure your account, and to verify you when you sign in."}],["$","li",null,{"children":"To attribute referrals to you — and to make sure the same business is not credited twice or to the wrong partner."}],["$","li",null,{"children":"To calculate commission, rank, wallet balances and payouts, and to produce your statements."}],["$","li",null,{"children":"To show your dashboard, referrals and growth analytics."}],["$","li",null,{"children":"To publish the partner leaderboard described below."}],["$","li",null,{"children":"To send you notifications about new referrals, commission and payouts, where you have allowed notifications."}],["$","li",null,{"children":"To answer your support requests and resolve disputes about attribution or payment."}],["$","li",null,{"children":"To detect and prevent abuse — self-referrals, duplicate accounts, fictitious businesses and attempts to manipulate commission."}],["$","li",null,{"children":"To keep the service secure and to investigate incidents."}],["$","li",null,{"children":"To meet tax, accounting and other legal obligations that apply to us."}],["$","li",null,{"children":"To understand how the app is used so that we can improve it."}]]}],["$","p",null,{"children":"We do not sell your personal information, and we do not use it for third-party advertising."}]]}]]}]
1c:["$","section","leaderboard",{"id":"leaderboard","className":"scroll-mt-24 pb-12","children":[["$","h2",null,{"className":"display-sm flex gap-4 text-[22px] sm:text-[26px]","children":[["$","span",null,{"className":"tnum text-brand","children":"05"}],"The partner leaderboard is public"]}],["$","div",null,{"className":"legal-body text-ink-soft mt-5 space-y-4 text-[14.5px] leading-relaxed","children":[["$","p",null,{"children":"We publish a leaderboard of partners on this website. It can be read without signing in. If your account passes the programme’s minimum for inclusion — currently 100 active clients — the leaderboard shows your name, your referral code, your rank title, the number of your active clients, your total commission and your earnings for the current month. It does not show your mobile number, email address, home address or payout details."}],["$","p",null,{"children":"Separately, when someone checks a referral code, they see the name and mobile number registered to that partner account, so the business can confirm who is introducing them. A referral code is made to be shared, but treat your code and the figures attached to it as public."}],["$","p",null,{"children":["If you would rather not appear on the leaderboard, write to"," ",["$","a",null,{"href":"mailto:hello@byaparekhata.com","children":"hello@byaparekhata.com"}]," and we will remove you from it. Being removed does not affect your account, your referrals or your commission."]}]]}]]}]
1d:["$","section","legal-basis",{"id":"legal-basis","className":"scroll-mt-24 pb-12","children":[["$","h2",null,{"className":"display-sm flex gap-4 text-[22px] sm:text-[26px]","children":[["$","span",null,{"className":"tnum text-brand","children":"06"}],"Basis for processing"]}],["$","div",null,{"className":"legal-body text-ink-soft mt-5 space-y-4 text-[14.5px] leading-relaxed","children":["$","p",null,{"children":"We process your information because it is necessary to perform the agreement you have with us as a partner, because we have a legitimate interest in running and securing the partner programme, because you have given consent (for example for push notifications), or because the law requires it. Where processing relies on consent, you may withdraw it at any time without affecting what you have already earned or the service you have already received."}]}]]}]
1e:["$","section","sharing",{"id":"sharing","className":"scroll-mt-24 pb-12","children":[["$","h2",null,{"className":"display-sm flex gap-4 text-[22px] sm:text-[26px]","children":[["$","span",null,{"className":"tnum text-brand","children":"07"}],"Who we share information with"]}],["$","div",null,{"className":"legal-body text-ink-soft mt-5 space-y-4 text-[14.5px] leading-relaxed","children":[["$","p",null,{"children":"We share information only where it is needed, and only with parties who are bound to protect it."}],["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Recipient"}],["$","th",null,{"children":"What is shared"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":"Businesses you refer"}],["$","td",null,{"children":"Your name and referral code, so the business knows who introduced them. You appear to them as a partner, not as someone with access to their books."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Banks and payment providers"}],["$","td",null,{"children":"The amount of a payout and the account details you supplied, in order to pay your commission."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"SMS, email and push providers"}],["$","td",null,{"children":"Your mobile number, email address or device token and the message content, to deliver notifications and one-time codes."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Cloud hosting and storage providers"}],["$","td",null,{"children":"The data needed to run, store and back up the service, including uploaded files."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Analytics and crash-reporting providers"}],["$","td",null,{"children":"Technical and diagnostic data used to keep the app stable."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Professional advisers and authorities"}],["$","td",null,{"children":"Where we are required by law, or to establish or defend a legal claim."}]]}]]}]]}],["$","p",null,{"children":"We may publish aggregated statistics — for example the number of active partners or the total commission paid — but never your individual figures outside the leaderboard described above."}]]}]]}]
1f:["$","section","retention",{"id":"retention","className":"scroll-mt-24 pb-12","children":[["$","h2",null,{"className":"display-sm flex gap-4 text-[22px] sm:text-[26px]","children":[["$","span",null,{"className":"tnum text-brand","children":"08"}],"How long we keep information"]}],["$","div",null,{"className":"legal-body text-ink-soft mt-5 space-y-4 text-[14.5px] leading-relaxed","children":[["$","p",null,{"children":"We keep your account, referral and wallet records for as long as your partner account is open. Commission and payout records are kept after your account closes for as long as tax and accounting law requires, and for as long as we may need them to resolve a dispute about attribution or payment."}],["$","p",null,{"children":"Your entry disappears from the leaderboard as soon as your account is closed or no longer meets the threshold."}],["$","p",null,{"children":"Backups are retained on a rolling cycle and are overwritten as part of normal operation. Records in backups are not used for any other purpose."}]]}]]}]
20:["$","section","security",{"id":"security","className":"scroll-mt-24 pb-12","children":[["$","h2",null,{"className":"display-sm flex gap-4 text-[22px] sm:text-[26px]","children":[["$","span",null,{"className":"tnum text-brand","children":"09"}],"How we protect your information"]}],["$","div",null,{"className":"legal-body text-ink-soft mt-5 space-y-4 text-[14.5px] leading-relaxed","children":[["$","p",null,{"children":"Traffic between the app and our servers is encrypted in transit, and your records are encrypted at rest. Signing in uses a one-time code sent to your mobile number; if you set a password it is stored only as a hash."}],["$","p",null,{"children":"Sessions use short-lived access tokens and refresh tokens that rotate on every use. Tokens are stored hashed, are bound to the device that created them, and presenting one that has already been rotated revokes the whole session. Sign-in and other sensitive endpoints are rate limited. Deletes are soft, so a mistake is recoverable rather than final, and every request carries an identifier so that support can trace an issue precisely."}],["$","p",null,{"children":"Staff access to partner records is limited to the people who administer the programme."}],["$","p",null,{"children":"No system is perfectly secure. Keep your device locked, do not share one-time codes, and tell us promptly if you suspect someone else has access to your account."}]]}]]}]
21:["$","section","your-rights",{"id":"your-rights","className":"scroll-mt-24 pb-12","children":[["$","h2",null,{"className":"display-sm flex gap-4 text-[22px] sm:text-[26px]","children":[["$","span",null,{"className":"tnum text-brand","children":"10"}],"Your rights and choices"]}],["$","div",null,{"className":"legal-body text-ink-soft mt-5 space-y-4 text-[14.5px] leading-relaxed","children":[["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Access."}]," Ask us what personal information we hold about you."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Correction."}]," Correct inaccurate details, or edit them yourself in the app."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Export."}]," Ask for a statement of your referrals, commission and payouts."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Deletion."}]," Close your partner account and have your information deleted, subject to the retention described above."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Withdraw consent."}]," Turn notifications off in the app or in your device settings, and ask us to remove you from the leaderboard."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Object or restrict."}]," Ask us to stop or limit a particular use of your information."]}]]}],["$","p",null,{"children":["Write to ",["$","a",null,{"href":"mailto:hello@byaparekhata.com","children":"hello@byaparekhata.com"}]," to make a request. We will respond within 30 days. If you are not satisfied with our response, you may raise the matter with the relevant authority in Nepal."]}]]}]]}]
22:["$","section","deleting-your-account",{"id":"deleting-your-account","className":"scroll-mt-24 pb-12","children":[["$","h2",null,{"className":"display-sm flex gap-4 text-[22px] sm:text-[26px]","children":[["$","span",null,{"className":"tnum text-brand","children":"11"}],"Closing your account"]}],["$","div",null,{"className":"legal-body text-ink-soft mt-5 space-y-4 text-[14.5px] leading-relaxed","children":[["$","p",null,{"children":["To close your partner account, write to"," ",["$","a",null,{"href":"mailto:support@byaparekhata.com","children":"support@byaparekhata.com"}]," from the email address on your account, or call ","+977 9800 000 000",". We will ask you to confirm the request from the mobile number registered to the account, so that nobody else can close it."]}],["$","p",null,{"children":"When your account is closed we delete or anonymise:"}],["$","ul",null,{"children":[["$","li",null,{"children":"your name, mobile number, email address and profile photo;"}],["$","li",null,{"children":"your referral code, and your entry on the leaderboard;"}],["$","li",null,{"children":"your device tokens and every active session."}]]}],["$","p",null,{"children":"We keep:"}],["$","ul",null,{"children":[["$","li",null,{"children":"commission, wallet and payout records, for as long as tax and accounting law requires and so that a dispute about payment can still be settled;"}],["$","li",null,{"children":"a record of referrals that were paid, so that they cannot be credited a second time."}]]}],["$","p",null,{"children":"We will action a deletion request within 30 days. Copies held in backups are removed as the backup cycle rolls over."}],["$","p",null,{"children":["Closing your ","Byapar ePartner"," account does not close a separate Byapar eKhata business account, and closing a Byapar eKhata account does not close your partner account. Ask us to close both if that is what you intend."]}]]}]]}]
23:["$","section","children",{"id":"children","className":"scroll-mt-24 pb-12","children":[["$","h2",null,{"className":"display-sm flex gap-4 text-[22px] sm:text-[26px]","children":[["$","span",null,{"className":"tnum text-brand","children":"12"}],"Children"]}],["$","div",null,{"className":"legal-body text-ink-soft mt-5 space-y-4 text-[14.5px] leading-relaxed","children":["$","p",null,{"children":["Byapar ePartner"," is a business programme and is not intended for anyone under 18. We do not knowingly collect personal information from children. If you believe a child has provided us with information, contact us and we will remove it."]}]}]]}]
24:["$","section","transfers",{"id":"transfers","className":"scroll-mt-24 pb-12","children":[["$","h2",null,{"className":"display-sm flex gap-4 text-[22px] sm:text-[26px]","children":[["$","span",null,{"className":"tnum text-brand","children":"13"}],"Where your information is stored"]}],["$","div",null,{"className":"legal-body text-ink-soft mt-5 space-y-4 text-[14.5px] leading-relaxed","children":["$","p",null,{"children":"Your data is stored on infrastructure that may be located outside Nepal, including with cloud providers. Where information is transferred abroad, we require the recipients to protect it to a standard consistent with this policy and with applicable law."}]}]]}]
25:["$","section","cookies",{"id":"cookies","className":"scroll-mt-24 pb-12","children":[["$","h2",null,{"className":"display-sm flex gap-4 text-[22px] sm:text-[26px]","children":[["$","span",null,{"className":"tnum text-brand","children":"14"}],"Cookies on our website"]}],["$","div",null,{"className":"legal-body text-ink-soft mt-5 space-y-4 text-[14.5px] leading-relaxed","children":["$","p",null,{"children":"Our website uses only the cookies and local storage needed to make the site work and to understand, in aggregate, which pages are useful. We do not use advertising cookies and we do not sell audience data. You can block cookies in your browser, though parts of the site may then behave differently. The app itself does not use advertising identifiers to track you across other companies’ apps or websites."}]}]]}]
26:["$","section","changes",{"id":"changes","className":"scroll-mt-24 pb-12","children":[["$","h2",null,{"className":"display-sm flex gap-4 text-[22px] sm:text-[26px]","children":[["$","span",null,{"className":"tnum text-brand","children":"15"}],"Changes to this policy"]}],["$","div",null,{"className":"legal-body text-ink-soft mt-5 space-y-4 text-[14.5px] leading-relaxed","children":["$","p",null,{"children":"We may update this policy as the programme or the law changes. When we make a material change we will notify you in the app before it takes effect. The date at the top of this page always shows the current version."}]}]]}]
