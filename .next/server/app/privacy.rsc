2a:["$","section","legal-basis",{"id":"legal-basis","className":"scroll-mt-24 pb-12","children":[["$","h2",null,{"className":"display-sm flex gap-4 text-[22px] sm:text-[26px]","children":[["$","span",null,{"className":"tnum text-brand","children":"04"}],"Basis for processing"]}],["$","div",null,{"className":"legal-body text-ink-soft mt-5 space-y-4 text-[14.5px] leading-relaxed","children":["$","p",null,{"children":"We process your information because it is necessary to provide the service you have asked for, because we have a legitimate interest in operating and securing the service, because you have given consent (for example, for SMS reminders or marketing messages), or because the law requires it. Where processing relies on consent, you may withdraw it at any time without affecting the service you have already received."}]}]]}]
2b:["$","section","sharing",{"id":"sharing","className":"scroll-mt-24 pb-12","children":[["$","h2",null,{"className":"display-sm flex gap-4 text-[22px] sm:text-[26px]","children":[["$","span",null,{"className":"tnum text-brand","children":"05"}],"Who we share information with"]}],["$","div",null,{"className":"legal-body text-ink-soft mt-5 space-y-4 text-[14.5px] leading-relaxed","children":[["$","p",null,{"children":"We share information only where it is needed, and only with parties who are bound to protect it."}],["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Recipient"}],["$","th",null,{"children":"What is shared"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":"Payment providers (eSewa, Khalti, Fonepay)"}],["$","td",null,{"children":"Amount, plan and a transaction reference, to process your subscription payment."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"SMS, email and push providers"}],["$","td",null,{"children":"The mobile number, email address or device token and the message content, to deliver reminders and notifications."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Cloud hosting and storage providers"}],["$","td",null,{"children":"The data needed to run and store the service, including backups and uploaded files."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Analytics and diagnostics providers"}],["$","td",null,{"children":"Technical and usage data used to keep the service stable."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Professional advisers and authorities"}],["$","td",null,{"children":"Where we are required by law, or to establish or defend legal claims."}]]}]]}]]}],["$","p",null,{"children":"We may share aggregated, non-identifying statistics — for example, the number of businesses using a feature — but never your individual records."}]]}]]}]
2c:["$","section","referrals",{"id":"referrals","className":"scroll-mt-24 pb-12","children":[["$","h2",null,{"className":"display-sm flex gap-4 text-[22px] sm:text-[26px]","children":[["$","span",null,{"className":"tnum text-brand","children":"06"}],"Referral and marketer programme"]}],["$","div",null,{"className":"legal-body text-ink-soft mt-5 space-y-4 text-[14.5px] leading-relaxed","children":["$","p",null,{"children":"If you join the referral programme or become a marketer, we process the details you give us (such as your contact details and payout information), the referrals attributed to you, and the commission and payouts generated. Where a referral credits a marketer, the new business is shown that they signed up through a referral link; we do not share the referred business’s financial records with the marketer."}]}]]}]
2d:["$","section","retention",{"id":"retention","className":"scroll-mt-24 pb-12","children":[["$","h2",null,{"className":"display-sm flex gap-4 text-[22px] sm:text-[26px]","children":[["$","span",null,{"className":"tnum text-brand","children":"07"}],"How long we keep information"]}],["$","div",null,{"className":"legal-body text-ink-soft mt-5 space-y-4 text-[14.5px] leading-relaxed","children":[["$","p",null,{"children":"We keep your account and business records for as long as your account is open. If you delete your account, we delete or anonymise your personal information and your business records within a reasonable period, except where we must keep records longer to satisfy tax, accounting or legal obligations, or to resolve a dispute."}],["$","p",null,{"children":"Backups are retained on a rolling cycle and are overwritten as part of normal operation. Records in backups are not used for any other purpose."}]]}]]}]
2e:["$","section","security",{"id":"security","className":"scroll-mt-24 pb-12","children":[["$","h2",null,{"className":"display-sm flex gap-4 text-[22px] sm:text-[26px]","children":[["$","span",null,{"className":"tnum text-brand","children":"08"}],"How we protect your information"]}],["$","div",null,{"className":"legal-body text-ink-soft mt-5 space-y-4 text-[14.5px] leading-relaxed","children":[["$","p",null,{"children":"Data is encrypted in transit and at rest. Access to your business data is scoped to the business you are signed into and enforced on the server for every request, not merely hidden in the interface. Sign-in on a new device requires a one-time code sent to your mobile number, and sessions use rotating tokens."}],["$","p",null,{"children":"We maintain activity logs that record who created, changed or deleted records, use soft deletion so mistakes can be recovered, apply rate limiting on sensitive endpoints, and track requests so that support can trace an issue precisely."}],["$","p",null,{"children":"No system is perfectly secure. Keep your device locked, do not share one-time codes, and tell us promptly if you suspect unauthorised access to your account."}]]}]]}]
2f:["$","section","offline",{"id":"offline","className":"scroll-mt-24 pb-12","children":[["$","h2",null,{"className":"display-sm flex gap-4 text-[22px] sm:text-[26px]","children":[["$","span",null,{"className":"tnum text-brand","children":"09"}],"Offline data on your device"]}],["$","div",null,{"className":"legal-body text-ink-soft mt-5 space-y-4 text-[14.5px] leading-relaxed","children":["$","p",null,{"children":"Byapar eKhata is designed to work without an internet connection. While you are offline, your records are stored on your device, and any changes you make are held in a local queue until they can be uploaded. This data remains on your device until it syncs, and may remain in the app’s local storage afterwards as a cache. Clearing the app’s data or uninstalling the app removes the local copy; your synced records remain in your account."}]}]]}]
30:["$","section","cookies",{"id":"cookies","className":"scroll-mt-24 pb-12","children":[["$","h2",null,{"className":"display-sm flex gap-4 text-[22px] sm:text-[26px]","children":[["$","span",null,{"className":"tnum text-brand","children":"10"}],"Cookies and similar technologies"]}],["$","div",null,{"className":"legal-body text-ink-soft mt-5 space-y-4 text-[14.5px] leading-relaxed","children":["$","p",null,{"children":"Our website uses only the cookies and local storage needed to make the site work and to understand, in aggregate, which pages are useful. We do not use advertising cookies and we do not sell audience data. You can block cookies in your browser, though parts of the site may then behave differently."}]}]]}]
31:["$","section","your-rights",{"id":"your-rights","className":"scroll-mt-24 pb-12","children":[["$","h2",null,{"className":"display-sm flex gap-4 text-[22px] sm:text-[26px]","children":[["$","span",null,{"className":"tnum text-brand","children":"11"}],"Your rights and choices"]}],["$","div",null,{"className":"legal-body text-ink-soft mt-5 space-y-4 text-[14.5px] leading-relaxed","children":[["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Access."}]," Ask us what personal information we hold about you."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Correction."}]," Correct inaccurate details, or edit them yourself in the app."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Export."}]," Export your reports to PDF or Excel at any time, or request a full export of your data."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Deletion."}]," Request deletion of your account and the records in it, subject to the retention obligations described above."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Withdraw consent."}]," Turn off SMS or marketing messages at any time in the app, or by writing to us."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Object or restrict."}]," Ask us to stop or limit a particular use of your information."]}]]}],["$","p",null,{"children":["Write to ",["$","a",null,{"href":"mailto:hello@byaparekhata.com","children":"hello@byaparekhata.com"}]," to make a request. We will respond within 30 days. If you are not satisfied with our response, you may raise the matter with the relevant authority in Nepal."]}]]}]]}]
32:["$","section","children",{"id":"children","className":"scroll-mt-24 pb-12","children":[["$","h2",null,{"className":"display-sm flex gap-4 text-[22px] sm:text-[26px]","children":[["$","span",null,{"className":"tnum text-brand","children":"12"}],"Children"]}],["$","div",null,{"className":"legal-body text-ink-soft mt-5 space-y-4 text-[14.5px] leading-relaxed","children":["$","p",null,{"children":"Byapar eKhata is a business tool and is not intended for children. We do not knowingly collect personal information from anyone under 16. If you believe a child has provided us with information, contact us and we will remove it."}]}]]}]
33:["$","section","transfers",{"id":"transfers","className":"scroll-mt-24 pb-12","children":[["$","h2",null,{"className":"display-sm flex gap-4 text-[22px] sm:text-[26px]","children":[["$","span",null,{"className":"tnum text-brand","children":"13"}],"Where your information is stored"]}],["$","div",null,{"className":"legal-body text-ink-soft mt-5 space-y-4 text-[14.5px] leading-relaxed","children":["$","p",null,{"children":"Your data is stored on infrastructure that may be located outside Nepal, including with cloud providers. Where information is transferred abroad, we require the recipients to protect it to a standard consistent with this policy and with applicable law."}]}]]}]
